<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><AssemblyName>AzerothAbilities</AssemblyName>
    <NuGetAudit>false</NuGetAudit><LangVersion>latest</LangVersion><Nullable>disable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <BepInExRoot>$(MSBuildProjectDirectory)/../../Megabonk-Lab/BepInEx</BepInExRoot>
    <RestorePackagesPath>$(MSBuildProjectDirectory)/../../cache/nuget</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(BepInExRoot)/core/BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(BepInExRoot)/core/BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExRoot)/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepInExRoot)/core/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(BepInExRoot)/interop/Unity*.dll"><Private>false</Private></Reference><Reference Include="$(BepInExRoot)/interop/Assembly-CSharp.dll"><Private>false</Private></Reference><Reference Include="$(BepInExRoot)/interop/Il2Cppmscorlib.dll"><Private>false</Private></Reference>
    <None Update="catalogs/**/*.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="mage.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  <Reference Include="$(BepInExRoot)/interop/Il2CppSystem.Core.dll"><Private>false</Private></Reference></ItemGroup>
</Project>



