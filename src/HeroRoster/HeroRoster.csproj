<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AzerothHeroes</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <LabRoot Condition="'$(LabRoot)' == ''">$(MSBuildProjectDirectory)/../..</LabRoot>
    <GameRoot>$(LabRoot)/Megabonk-Lab</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameRoot)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(GameRoot)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameRoot)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameRoot)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameRoot)/BepInEx/interop/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GameRoot)/BepInEx/interop/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(GameRoot)/BepInEx/interop/Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(GameRoot)/BepInEx/interop/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameRoot)/BepInEx/interop/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(GameRoot)/BepInEx/interop/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(GameRoot)/BepInEx/interop/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(GameRoot)/BepInEx/interop/Unity.Localization.dll" Private="false" />
  </ItemGroup>
  <ItemGroup><None Update="classes.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None></ItemGroup>
</Project>
